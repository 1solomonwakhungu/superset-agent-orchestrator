{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "matrixVersion": "2026-07-24",
  "evidenceReviewedAt": "2026-07-24",
  "classifications": {
    "verified": "A repeatable probe passed for the exact recorded combination.",
    "contract-supported": "Primary documentation supports the claim, but the complete combination has not passed every required lane.",
    "experimental": "Commit-pinned research evidence that is opt-in, disabled by default, and not production support.",
    "unsupported": "A known incompatible dimension or an operation excluded by the supported contract.",
    "unknown": "The combination has not produced qualifying evidence and must fail before mutation."
  },
  "supportPolicy": {
    "defaultClassification": "unknown",
    "failBeforeMutation": true,
    "allowImplicitVersionCoverage": false,
    "allowFallback": false,
    "compatibilityError": {
      "code": "UNSUPPORTED_COMBINATION",
      "requiredFields": [
        "classification",
        "detected",
        "unsupportedDimensions",
        "supportedAlternatives",
        "probeCommand"
      ],
      "probeCommand": "npm run compatibility:probe"
    },
    "revalidationTriggers": [
      "operating-system lane change",
      "Node.js or npm version change",
      "MCP SDK lockfile version change",
      "MCP protocol negotiation change",
      "Superset Desktop or CLI version change",
      "Desktop and bundled CLI version mismatch",
      "agent preset or harness version change",
      "upstream evidence revision change"
    ],
    "evidenceRedactions": [
      "user names and home paths",
      "organization, host, project, and workspace identifiers",
      "workspace and repository names",
      "prompts, transcripts, results, and terminal output",
      "credentials, tokens, environment values, and process arguments"
    ]
  },
  "supportedEnvelope": {
    "operatingSystems": ["darwin", "linux"],
    "nodeMajors": [22, 24],
    "npmMajor": 10,
    "mcpSdk": {
      "package": "@modelcontextprotocol/sdk",
      "major": 1,
      "lockedVersion": "1.29.0"
    },
    "transport": "stdio",
    "superset": {
      "desktopCliPairs": ["1.16.1/1.16.1"],
      "stableOperations": ["configured-agent-discovery", "launch-metadata"],
      "unavailableOperations": ["session-list", "session-status", "exact-result", "stop-reason", "cancellation", "backend-recovery"]
    }
  },
